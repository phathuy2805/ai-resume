  "info": {
    "title": "AI-Resume API SPEC",
    "description": "Tài liệu API hệ thống tuyển dụng AI-Resume (Specs v1.0)",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "JWT-auth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Nhập access Token"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "description": "Email người dùng"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "description": "Mật khẩu người dùng"
          },
          "fullName": {
            "type": "string",
            "minLength": 1,
            "description": "Họ và tên đầy đủ"
          },
          "role": {
            "type": "string",
            "enum": [
              "CANDIDATE",
              "HR"
            ],
            "description": "Vai trò trong hệ thống (HR hoặc CANDIDATE)"
          }
        },
        "required": [
          "email",
          "password",
          "fullName",
          "role"
        ]
      },
      "AuthResponseDto_Output": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Access Token JWT"
          },
          "refreshToken": {
            "type": "string",
            "description": "Refresh Token JWT"
          },
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                "description": "ID người dùng (UUID)"
              },
              "email": {
                "type": "string",
                "format": "email",
                "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
                "description": "Email người dùng"
              },
              "fullName": {
                "type": "string",
                "description": "Họ và tên"
              },
              "role": {
                "type": "string",
                "enum": [
                  "HR",
                  "CANDIDATE",
                  "ADMIN"
                ],
                "description": "Vai trò người dùng"
              },
              "createdAt": {
                "type": "string",
                "description": "Thời điểm tạo tài khoản (ISO 8601)"
              }
            },
            "required": [
              "id",
              "email",
              "fullName",
              "role",
              "createdAt"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "user"
        ],
        "additionalProperties": false
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "description": "Email đăng nhập"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "description": "Mật khẩu"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "UserProfileResponseDto_Output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "ID người dùng (UUID)"
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "description": "Email người dùng"
          },
