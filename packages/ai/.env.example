# Chỉ dùng cho `npm run try -w packages/ai` (chạy thử với Gemini thật).
# Copy thành packages/ai/.env rồi điền giá trị. File .env đã nằm trong .gitignore, KHÔNG commit.
# Biến đặt trong terminal ($env:GEMINI_API_KEY = ...) được ưu tiên hơn file này.

# Lấy tại https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Tên model dạng ngắn, không có tiền tố "models/". Bắt buộc: text. Chưa dùng: embedding, audio.
GEMINI_MODEL_TEXT=
GEMINI_MODEL_EMBEDDING=
GEMINI_MODEL_AUDIO=
