# Application Port & Environment
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# PostgreSQL + pgvector (Local Docker / Production)
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_resume?schema=public
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/ai_resume_test?schema=public

# Seed Password (dùng cho prisma/seed.ts)
SEED_DEFAULT_PASSWORD=ChangeMe123!

# Redis (Queue BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your-super-secret-refresh-key
REFRESH_TOKEN_EXPIRES_IN=7d

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key

# AWS Ecosystem Configuration (S3, SNS, SES)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# AWS S3 (Bucket for CV PDF and Interview Audio WAV)
AWS_S3_BUCKET_NAME=hireflow-storage-bucket
AWS_S3_SIGNED_URL_EXPIRES_IN=3600

# AWS SNS (Notifications Topic ARN)
AWS_SNS_TOPIC_ARN=arn:aws:sns:ap-southeast-1:123456789012:hireflow-notifications

# AWS SES (Email Sender)
AWS_SES_SENDER_EMAIL=noreply@hireflow.com

# Rate Limiting (@nestjs/throttler)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

