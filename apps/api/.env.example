# Application Port & Environment
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# PostgreSQL + pgvector (Local Docker / Production)
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_resume?schema=public
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/ai_resume_test?schema=public

# Seed Password (dùng cho prisma/seed.ts)
SEED_DEFAULT_PASSWORD=ChangeMe123!

# Redis (Queue BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
ACCESS_TOKEN_SECRET=your-super-secret-access-key
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your-super-secret-refresh-key
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key

# AWS Ecosystem Configuration (SNS, SES)
# KHÔNG khai báo AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY ở đây: AWS SDK ưu tiên 2 biến này
# hơn IAM Role trên EC2, giá trị giả sẽ làm mọi lệnh gọi AWS thất bại.
AWS_REGION=ap-southeast-1

# Amazon S3 (CV PDF, audio và transcript phỏng vấn) - bucket private
# Dev: bucket hireflow-uploads-dev + key IAM user hireflow-dev-<tên> (xin Tùng/Huy, không commit)
# Production: chỉ S3_BUCKET=hireflow-uploads và S3_REGION; bỏ trống 2 key, EC2 dùng IAM Role
S3_BUCKET=hireflow-uploads-dev
S3_REGION=ap-southeast-2
S3_ACCESS_KEY=
S3_SECRET_KEY=

# AWS SNS (Notifications Topic ARN)
AWS_SNS_TOPIC_ARN=arn:aws:sns:ap-southeast-1:123456789012:hireflow-notifications

# AWS SES (Email Sender)
AWS_SES_SENDER_EMAIL=noreply@hireflow.com

# Rate Limiting (@nestjs/throttler)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

