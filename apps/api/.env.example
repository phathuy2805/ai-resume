# Application
NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# PostgreSQL + pgvector
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_resume?schema=public
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/ai_resume_test?schema=public
SEED_DEFAULT_PASSWORD=ChangeMe123!

# JWT Authentication
ACCESS_TOKEN_SECRET=your-super-secret-access-key
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your-super-secret-refresh-key
REFRESH_TOKEN_EXPIRES_IN=7d

# Amazon S3 (CV PDF, audio và transcript) - bucket private
# Dev: bucket hireflow-uploads-dev + key IAM user
# Production: chỉ cần S3_BUCKET và S3_REGION (bỏ trống 2 key nếu EC2 dùng IAM Role)
S3_BUCKET=hireflow-uploads-dev
S3_REGION=ap-southeast-2
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Redis & Gemini AI (Tuần 2 - BullMQ Screening & AI)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL_TEXT=gemini-2.5-flash-lite
GEMINI_MODEL_EMBEDDING=gemini-embedding-001
GEMINI_MODEL_AUDIO=gemini-3.5-flash-lite
AI_QUEUE_CONCURRENCY=2
AI_CONSIDER_MARGIN=10
