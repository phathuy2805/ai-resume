{$DOMAIN:localhost} {
    encode gzip zstd

    # Chuyển hướng API và WebSocket vào service api
    handle /api/* {
        reverse_proxy api:3000
    }

    handle /socket.io/* {
        reverse_proxy api:3000
    }

    # Phục vụ Frontend Vite tĩnh (chỉ fallback SPA cho các route không phải /api/*)
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
